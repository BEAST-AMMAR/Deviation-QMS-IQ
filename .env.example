# === AIVOA.AI Deviation Intake Module ===
# Copy this file to .env and fill in values

# Groq API
GROQ_API_KEY=gsk_your_key_here

# PostgreSQL
POSTGRES_USER=aivoa
POSTGRES_PASSWORD=aivoa_dev_password
POSTGRES_DB=aivoa_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aivoa:aivoa_dev_password@db:5432/aivoa_db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
