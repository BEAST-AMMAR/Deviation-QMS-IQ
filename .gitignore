# ========================================================
# DeviationIQ — Root .gitignore Configuration
# ========================================================

# Environment Variables & Secrets
.env
backend/.env
frontend/.env.local
*.env.local

# Databases & Local Persistence
*.db
*.db-journal
*.sqlite
*.sqlite3
pgdata/

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual Environments
.venv/
venv/
ENV/
backend/.venv/

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.tox/

# Node.js & Frontend Build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Docker Overrides & Logs
docker-compose.override.yml
*.log

# Temporary Report Generation Files
*.temp.html
test_*.pdf
test_*.html
test_*.png
